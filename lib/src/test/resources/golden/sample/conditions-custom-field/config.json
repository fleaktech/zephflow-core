{
  "sampleRateField": "rate",
  "rules": [
    {"condition": "($.a / $.b) > 1", "sampleRate": 2},
    {"condition": "($.a % $.b) > 100", "sampleRate": 2},
    {"condition": "$.flag", "sampleRate": 2},
